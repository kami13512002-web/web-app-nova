{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "028a47d3-b9ba-4a02-b62d-a376532016df","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3594747bbec4475f8b3825efb57a2538" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
